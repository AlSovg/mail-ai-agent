# Приложение (src/mailagent, см. config.py)
DATABASE_URL=postgresql+asyncpg://mailagent:mailagent@localhost:5434/mailagent
TELEGRAM_BOT_TOKEN=  # от @BotFather
TELEGRAM_WEBHOOK_SECRET=  # A-Za-z0-9_-, 1–256
TELEGRAM_WEBHOOK_URL=  # https://…/webhook/telegram; пусто — webhook не регистрируется
TOKEN_ENCRYPTION_KEY=  # 32 байта в base64
MAIL_CLIENT_ID=
MAIL_CLIENT_SECRET=
MAIL_REDIRECT_URI=  # https://…/oauth/callback, как в приложении o2.mail.ru
# MAIL_SCOPE=openid email mail.imap offline_access
LLM_BASE_URL=  # OpenAI-совместимый API, например https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=  # например qwen/qwen3-30b-a3b

# Туннель (docker compose --profile tunnel up ngrok)
# NGROK_AUTHTOKEN=
# NGROK_DOMAIN=xxx.ngrok-free.app

# Спайки (spikes/), приложению не нужны
# MAIL_ADDRESS=test@mail.ru
# MAIL_REDIRECT=http://localhost:8899/callback/  # совпадает с приложением до символа
# OPENROUTER_KEY=
